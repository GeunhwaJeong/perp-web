# /etc/caddy/Caddyfile on the Sigma VPS (149.56.47.78). Caddy obtains the certificates.

# The trading site: a static build of this repository.
sigma.haneul.io {
    encode gzip

    # The name issuer (sigma-names.service): same origin as the site, prefix stripped.
    @issuer path /issuer/*
    handle @issuer {
        uri strip_prefix /issuer
        reverse_proxy 127.0.0.1:8790
    }

    # The order-ticket keeper (sigma-keeper.service): the site hands it a ticket's order details
    # before the ticket goes on chain. Only that intake is public, prefix stripped; the keeper's
    # status and metrics stay on the loopback. Caddy replaces a client's X-Forwarded-For with the
    # client's address, which the keeper caps unmatched details by.
    @keeper {
        method POST
        path /keeper/v1/details
    }
    handle @keeper {
        request_body {
            max_size 64KB
        }
        uri strip_prefix /keeper
        reverse_proxy 127.0.0.1:9191
    }
    @keeperOther path /keeper /keeper/*
    handle @keeperOther {
        respond 404
    }

    # Everything else: the static build, with the single page at entry-points/index.html
    # (dYdX's hosting rewrote to it).
    handle {
        root * /var/www/sigma
        # Scripts run from this site only, and requests go to this site, the indexer API, the full
        # node and the price service only. The three hashes are the inline scripts the TradingView
        # library writes into the chart's frame (Advanced Charts 33.1.0); `scripts/haneul-mainnet/
        # csp.ts` checks a build against this line.
        header Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-Imv8rgvxn2GP4QJH/s+T5I8tEtsRwclyX3+LH36ke+U=' 'sha256-UkirSrOhyl2owLIRZtm0VusIDuET0YXn7cKQYvZVRa4=' 'sha256-yxzsY6Bi2C4+OSAgq5pgxd4AP6ElWbwhdkLXUWWLLvk='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://api.sigma.haneul.io wss://api.sigma.haneul.io https://rpc.haneul.io https://oracle.haneul.io; frame-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        # Browsers keep to https for a year, take a file as the type it is served with, and send
        # other sites no referrer.
        header Strict-Transport-Security "max-age=31536000"
        header X-Content-Type-Options "nosniff"
        header Referrer-Policy "same-origin"
        try_files {path} /entry-points/index.html
        header /entry-points/index.html Cache-Control "public, max-age=0, must-revalidate"
        header /assets/* Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
}

# The indexer API (REST and WebSocket) the site reads.
api.sigma.haneul.io {
    reverse_proxy 127.0.0.1:3002
}

# The price service's signed updates, which trades put in front of themselves.
oracle.haneul.io {
    reverse_proxy 127.0.0.1:8787
}

# TLS in front of the public full node's gRPC (plaintext h2c on the validator host), so that
# the site, served over https, can call it.
rpc.haneul.io {
    reverse_proxy h2c://158.69.54.239:9000
}

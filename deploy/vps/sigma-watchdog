#!/usr/bin/env python3
# Watches what cannot report on itself: the services that have no alerts of their own (price
# service, indexer, API, name issuer, Caddy, Postgres), any service that has died or hung, the
# venues the price service forms its prices from, the daily jobs (the keeper's backup, the
# indexer's pruning), and the machine (disk, memory, swap, clock). Runs every minute as `sigma` from
# sigma-watchdog.timer and posts to the same Discord webhook as the bots (PERP_ALERT_WEBHOOK_URL).
#
# A check has to fail on two runs in a row before it is posted, so that a restart of a few
# seconds says nothing. A failure is posted once, again every six hours while it lasts, and
# once more when it is over. Each run also appends the price service's memory to a CSV: that
# process grows until it is restarted, and the file shows how fast.
#
# With WATCHDOG_PING_URL set, a run that reaches its end fetches that URL. A service outside
# this machine that expects the fetch every minute then notices when the machine itself is gone,
# which nothing on the machine can report.

import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.request

STATE_DIR = os.environ.get("STATE_DIRECTORY", "/var/lib/sigma-watchdog")
STATE_FILE = os.path.join(STATE_DIR, "state.json")
MEMORY_LOG = os.path.join(STATE_DIR, "oracle-memory.csv")
WEBHOOK = os.environ.get("PERP_ALERT_WEBHOOK_URL")
PING = os.environ.get("WATCHDOG_PING_URL")

SERVICES = [
    "sigma-oracle",
    "sigma-indexer",
    "sigma-api",
    "sigma-liquidator",
    "sigma-cranker",
    "sigma-maker",
    "sigma-keeper",
    "sigma-names",
    "caddy",
    "postgresql@18-main",
]
# Jobs a timer runs once a day. A run that failed leaves its unit failed until a later run
# succeeds, and nothing else says so: the dumps stop, or the indexer's tables grow again.
JOBS = [
    "sigma-keeper-backup",
    "sigma-indexer-prune",
]
# (name, URL, the field that has to be true or "ok").
HEALTH = [
    ("price service", "http://127.0.0.1:8787/healthz", "healthy"),
    ("API", "http://127.0.0.1:3002/health", "status"),
    ("liquidator", "http://127.0.0.1:9188/health", "healthy"),
    ("cranker", "http://127.0.0.1:9189/health", "healthy"),
    ("maker", "http://127.0.0.1:9190/health", "healthy"),
    ("keeper", "http://127.0.0.1:9191/health", "healthy"),
    ("name issuer", "http://127.0.0.1:8790/health", "ok"),
]
SITE = "https://sigma.haneul.io/"

FAILS_BEFORE_ALERT = 2
REMIND_AFTER_S = 6 * 3600
# The price service is killed at 1,200 MB (sigma-oracle.service); say so before it gets there.
ORACLE_MEMORY_WARN_MB = 900
DISK_WARN_PERCENT = 80
SWAP_WARN_MB = 1024
AVAILABLE_WARN_MB = 300
# The price service exports the longest it was late to its own timers in the last minute. A
# process that keeps up stays under a tenth of a second; one that is late by a second reads
# the venues' streams late as well, and signs prices that are older than they look.
ORACLE_METRICS = "http://127.0.0.1:8787/metrics"
ORACLE_LATE_WARN_S = 1.0
# The price service signs a feed for as long as enough venues remain, and starts without a venue
# that is down or no longer lists a market. Its venues can go one by one, and its health says
# nothing until the last one a feed needs has gone. A venue is reported when the service has
# had nothing from it for this long: a venue was out for three minutes at most in an ordinary
# week and a half, and the service asks a venue it started without again every ten minutes.
ORACLE_SOURCE_OUT_WARN_S = 600
# A feed is reported when this many of its venues are missing from its latest price.
ORACLE_SOURCES_MISSING_WARN = 2
# What the service's counters read on the last run, and since when each venue's has not grown.
ORACLE_SOURCES_FILE = os.path.join(STATE_DIR, "oracle-sources.json")
# What the price service has waited for, a row a minute. The provider takes a snapshot of the
# machine every day at about 21:56 UTC, and for a while after it a disk request can take a
# second. On some of those days the price service, which hardly touches the disk, ran ten
# seconds late, and nothing kept says what it was waiting for: the kernel's counters for the
# service start from zero whenever it restarts.
PRESSURE_LOG = os.path.join(STATE_DIR, "oracle-pressure.csv")
PRESSURE_LOG_MAX_BYTES = 5 * 2**20
CGROUP_ROOT = "/sys/fs/cgroup"
PROC = "/proc"
# The price service stamps every price with this machine's clock, and the chain refuses a price
# stamped more than 3 s ahead of its own clock and treats one stamped 10 s behind as stale. The
# clock is set against time servers every seventeen minutes; left alone it loses about a second
# a day. Six hours without a time server is a fifth of a second: days before prices are refused.
CLOCK_UNSET_WARN_S = 6 * 3600
CLOCK_OFF_WARN_S = 0.5
CLOCK_MATTERS = "the price service stamps its prices with it, and the chain refuses them once it is seconds off"


def fetch(url, timeout=5):
    request = urllib.request.Request(url, headers={"User-Agent": "sigma-watchdog"})
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return response.status, response.read()


def check_services(problems):
    for unit in SERVICES:
        result = subprocess.run(["systemctl", "is-active", unit], capture_output=True, text=True)
        state = result.stdout.strip() or "unknown"
        if state != "active":
            problems[f"service:{unit}"] = f"{unit} is {state}"


def check_jobs(problems):
    for unit in JOBS:
        result = subprocess.run(["systemctl", "is-failed", unit], capture_output=True, text=True)
        if result.stdout.strip() == "failed":
            problems[f"job:{unit}"] = f"the last run of {unit} failed (journalctl -u {unit})"


def check_health(problems):
    for name, url, field in HEALTH:
        key = f"health:{name}"
        try:
            status, body = fetch(url)
            value = json.loads(body).get(field)
            if status != 200 or value not in (True, "ok"):
                problems[key] = f"the {name} reports itself unhealthy: {body[:200].decode(errors='replace')}"
        except Exception as error:  # noqa: BLE001 - any failure to answer is the finding
            problems[key] = f"the {name} does not answer its health check ({error})"
    try:
        status, _ = fetch(SITE)
        if status != 200:
            problems["site"] = f"{SITE} answers {status}"
    except Exception as error:  # noqa: BLE001
        problems["site"] = f"{SITE} does not answer ({error})"


def oracle_metrics():
    try:
        _, body = fetch(ORACLE_METRICS)
    except Exception:  # noqa: BLE001 - the health check already reports a service that is down
        return None
    return body.decode(errors="replace")


def check_oracle_lateness(problems, metrics):
    if metrics is None:
        return
    for line in metrics.splitlines():
        if line.startswith("oracle_event_loop_delay_seconds"):
            late = float(line.split()[-1])
            if late >= ORACLE_LATE_WARN_S:
                problems["oracle_late"] = (
                    f"the price service was {late:.1f} s late to its own timers in the last minute: "
                    "it is falling behind the venues"
                )
            return


METRIC_LINE = re.compile(r"^(\w+)(?:\{(.*)\})? (\S+)$")
METRIC_LABEL = re.compile(r'(\w+)="((?:[^"\\]|\\.)*)"')


def samples(metrics):
    """The samples of a Prometheus text exposition, as (name, labels, value)."""
    for line in metrics.splitlines():
        match = METRIC_LINE.match(line)
        if match is None:
            continue
        name, labels, value = match.groups()
        try:
            yield name, dict(METRIC_LABEL.findall(labels or "")), float(value)
        except ValueError:
            continue


def since_it_grew(before, count, could_grow, now, elapsed):
    """
    A counter's value and the time since which it has not grown, given what the last run kept.

    The service counts from zero when it starts again. A count that fell and is above zero has
    grown since then; one that fell to zero has not. While nothing could make the count grow,
    the time that passes is not held against it.
    """
    known = isinstance(before, dict) and "count" in before and "since" in before
    if not known or (count != before["count"] and count > 0):
        return {"count": count, "since": now}
    return {"count": count, "since": before["since"] if could_grow else before["since"] + elapsed}


def check_oracle_sources(problems, now, metrics):
    try:
        with open(ORACLE_SOURCES_FILE) as file:
            before = json.load(file)
    except (OSError, ValueError):
        before = {}
    if not isinstance(before, dict):
        before = {}

    rounds = 0.0
    signed, standing = {}, {}
    used, quoted = {}, {}
    for name, labels, value in samples(metrics or ""):
        if name == "oracle_rounds_total":
            rounds = value
        elif name == "oracle_feed_signed_total":
            signed[labels["feed"]] = value
        elif name == "oracle_feed_sources_used":
            standing[labels["feed"]] = value
        elif name == "oracle_feed_source_rounds_total":
            key = (labels["feed"], labels["source"])
            used[key] = value if labels["outcome"] == "used" else used.get(key, 0.0)
        elif name == "oracle_source_quotes_total":
            key = f"{labels['exchange']}:{labels['market']}"
            quoted[key] = quoted.get(key, 0.0) + (value if labels["result"] == "ok" else 0.0)
    if rounds == 0:
        # The service is down or has not run a round yet, which its health check reports. What
        # was said of its venues stands until it runs again.
        problems.update(before.get("problems", {}))
        return

    elapsed = max(0.0, now - before.get("at", now))
    found = {}
    # A venue is used only in a round that is signed. While a feed is not signed, for a reason
    # its health check reports, the venues that did answer are not counted as used either.
    sources = {}
    for (feed, source), count in used.items():
        key = f"{feed} {source}"
        feed_signed = signed.get(feed, 0.0) > before.get("signed", {}).get(feed, float("inf"))
        entry = since_it_grew(before.get("sources", {}).get(key), count, feed_signed, now, elapsed)
        sources[key] = entry
        if now - entry["since"] >= ORACLE_SOURCE_OUT_WARN_S:
            found[f"oracle_source:{key}"] = (
                f"the price service has left {source} out of {feed} for {duration(now - entry['since'])} "
                f'(journalctl -u sigma-oracle | grep "left out {source}")'
            )
    # The markets that are no feed's venue give the rates that other venues are converted with.
    # A round asks for them whether or not it is signed.
    quotes = {}
    ran = rounds > before.get("rounds", float("inf"))
    for key, count in quoted.items():
        if any(source == key for _, source in used):
            continue
        entry = since_it_grew(before.get("quotes", {}).get(key), count, ran, now, elapsed)
        quotes[key] = entry
        if now - entry["since"] >= ORACLE_SOURCE_OUT_WARN_S:
            found[f"oracle_quote:{key}"] = (
                f"the price service has had no quote of {key} for {duration(now - entry['since'])}"
            )
    for feed, count in standing.items():
        venues = sum(1 for of, _ in used if of == feed)
        # A feed that stands on none is not signed, which its health check reports.
        if 0 < count <= venues - ORACLE_SOURCES_MISSING_WARN:
            found[f"oracle_sources:{feed}"] = f"the price of {feed} stands on {int(count)} of its {venues} venues"
    problems.update(found)

    kept = {"at": now, "rounds": rounds, "signed": signed, "sources": sources, "quotes": quotes, "problems": found}
    try:
        temporary = ORACLE_SOURCES_FILE + ".part"
        with open(temporary, "w") as file:
            json.dump(kept, file)
        os.replace(temporary, ORACLE_SOURCES_FILE)
    except OSError as error:
        print(f"failed to keep the price service's counters: {error}", file=sys.stderr)


def stalled_seconds(path):
    """How long tasks have been stalled, from a pressure file: the total of its `some` line."""
    try:
        with open(path) as lines:
            for line in lines:
                if line.startswith("some"):
                    for field in line.split():
                        if field.startswith("total="):
                            return int(field[len("total="):]) / 1e6
    except (OSError, ValueError):
        pass
    return None


def record_oracle_pressure(now, metrics):
    """
    Appends to PRESSURE_LOG: the time, the price service's process, the seconds its tasks have
    been stalled on the disk, on memory and on the CPU since it started, the page faults it had
    to read from the disk, the longest it was late to its timers in the last minute, and the
    seconds any task on the machine has been stalled on the disk since boot. All but the
    lateness only grow, so what happened in a minute is the difference between two rows.
    """
    shown = subprocess.run(
        ["systemctl", "show", "sigma-oracle", "-p", "MainPID", "-p", "ControlGroup"], capture_output=True, text=True
    ).stdout
    unit = dict(line.split("=", 1) for line in shown.splitlines() if "=" in line)
    pid, group = unit.get("MainPID", ""), unit.get("ControlGroup", "")
    if pid in ("", "0") or not group:
        return
    row = [int(now), pid]
    row += [stalled_seconds(f"{CGROUP_ROOT}{group}/{resource}.pressure") for resource in ("io", "memory", "cpu")]
    try:
        with open(f"{PROC}/{pid}/stat") as file:
            # The fields after the name, which may hold spaces: the tenth of them is majflt.
            row.append(int(file.read().rsplit(")", 1)[1].split()[9]))
    except (OSError, ValueError, IndexError):
        row.append(None)
    late = None
    for line in (metrics or "").splitlines():
        if line.startswith("oracle_event_loop_delay_seconds"):
            late = float(line.split()[-1])
    row += [late, stalled_seconds(f"{PROC}/pressure/io")]
    try:
        if os.path.exists(PRESSURE_LOG) and os.path.getsize(PRESSURE_LOG) > PRESSURE_LOG_MAX_BYTES:
            os.replace(PRESSURE_LOG, PRESSURE_LOG + ".1")
        with open(PRESSURE_LOG, "a") as log:
            log.write(",".join("" if value is None else f"{value:.3f}" if isinstance(value, float) else str(value) for value in row) + "\n")
    except OSError as error:
        print(f"failed to record what the price service waited for: {error}", file=sys.stderr)


def clock_problem(tracking, now):
    """
    What is wrong with the clock, from the line `chronyc -c tracking` prints, or None. Its fields
    are comma-separated: the fourth is when the clock was last set against a time server (Unix
    seconds), the fifth how far it is from the servers' time now, the last whether it is
    synchronised at all.
    """
    fields = tracking.strip().split(",")
    try:
        set_at, off, state = float(fields[3]), abs(float(fields[4])), fields[13]
    except (ValueError, IndexError):
        return f"the machine's clock cannot be checked (chronyc said: {tracking.strip()[:80] or 'nothing'}); {CLOCK_MATTERS}"
    if state != "Normal":
        return f"the machine's clock is not synchronised (chrony: {state}); {CLOCK_MATTERS}"
    if now - set_at >= CLOCK_UNSET_WARN_S:
        return (
            f"the machine's clock was last set against a time server {duration(now - set_at)} ago "
            f"and loses about a second a day; {CLOCK_MATTERS}"
        )
    if off >= CLOCK_OFF_WARN_S:
        return f"the machine's clock is {off:.1f} s off the time servers; {CLOCK_MATTERS}"
    return None


def check_clock(problems, now):
    try:
        tracking = subprocess.run(
            ["chronyc", "-c", "tracking"], capture_output=True, text=True, timeout=10
        ).stdout
    except (OSError, subprocess.SubprocessError) as error:
        tracking = f"{error!r}"
    problem = clock_problem(tracking, now)
    if problem is not None:
        problems["clock"] = problem


def meminfo():
    values = {}
    with open("/proc/meminfo") as lines:
        for line in lines:
            name, rest = line.split(":", 1)
            values[name] = int(rest.split()[0]) // 1024
    return values


def oracle_memory_mb():
    pid = subprocess.run(
        ["systemctl", "show", "sigma-oracle", "-p", "MainPID", "--value"], capture_output=True, text=True
    ).stdout.strip()
    if not pid or pid == "0":
        return None
    try:
        with open(f"/proc/{pid}/status") as lines:
            for line in lines:
                if line.startswith("VmRSS:"):
                    return int(line.split()[1]) // 1024
    except OSError:
        return None
    return None


def check_machine(problems, now):
    disk = shutil.disk_usage("/")
    used = round(100 * disk.used / disk.total)
    if used >= DISK_WARN_PERCENT:
        problems["disk"] = f"the disk is {used}% full ({disk.free // 2**30} GB left)"
    memory = meminfo()
    swap_used = memory["SwapTotal"] - memory["SwapFree"]
    if swap_used >= SWAP_WARN_MB:
        problems["swap"] = f"{swap_used} MB of swap is in use: some process has outgrown the memory"
    if memory["MemAvailable"] < AVAILABLE_WARN_MB:
        problems["memory"] = f"only {memory['MemAvailable']} MB of memory is available"
    oracle = oracle_memory_mb()
    if oracle is not None:
        with open(MEMORY_LOG, "a") as log:
            log.write(f"{int(now)},{oracle}\n")
        if oracle >= ORACLE_MEMORY_WARN_MB:
            problems["oracle_memory"] = (
                f"the price service holds {oracle} MB; it is killed and restarted at 1,200 MB"
            )


def post(text):
    if not WEBHOOK:
        return
    body = json.dumps({"content": f"[sigma-watchdog] {text}"[:1900]}).encode()
    request = urllib.request.Request(
        WEBHOOK, data=body, headers={"Content-Type": "application/json", "User-Agent": "sigma-watchdog"}
    )
    try:
        urllib.request.urlopen(request, timeout=10).read()
    except Exception as error:  # noqa: BLE001
        print(f"failed to post an alert: {error}", file=sys.stderr)


def duration(seconds):
    minutes = int(seconds // 60)
    return f"{minutes} min" if minutes < 120 else f"{minutes // 60} h"


def main():
    now = time.time()
    try:
        with open(STATE_FILE) as file:
            state = json.load(file)
    except (OSError, ValueError):
        state = {}

    problems = {}
    check_services(problems)
    check_jobs(problems)
    check_health(problems)
    metrics = oracle_metrics()
    check_oracle_lateness(problems, metrics)
    try:
        check_oracle_sources(problems, now, metrics)
    except Exception as error:  # noqa: BLE001 - a fault in this check must not stop the others
        problems["oracle_sources_check"] = f"the watchdog could not check the price service's venues ({error!r})"
    try:
        record_oracle_pressure(now, metrics)
    except Exception as error:  # noqa: BLE001 - a record that cannot be kept must not stop the checks
        print(f"failed to record what the price service waited for: {error!r}", file=sys.stderr)
    check_machine(problems, now)
    check_clock(problems, now)

    for key, message in problems.items():
        entry = state.setdefault(key, {"fails": 0, "since": now, "posted": None})
        entry["fails"] += 1
        entry["message"] = message
        print(f"problem {key}: {message}")
        if entry["fails"] < FAILS_BEFORE_ALERT:
            continue
        if entry["posted"] is None:
            post(f"WARNING: {message}")
            entry["posted"] = now
        elif now - entry["posted"] >= REMIND_AFTER_S:
            post(f"WARNING: still, for {duration(now - entry['since'])}: {message}")
            entry["posted"] = now
    for key in [key for key in state if key not in problems]:
        entry = state.pop(key)
        if entry.get("posted") is not None:
            post(f"INFO: over after {duration(now - entry['since'])}: {entry.get('message', key)}")

    temporary = STATE_FILE + ".part"
    with open(temporary, "w") as file:
        json.dump(state, file)
    os.replace(temporary, STATE_FILE)

    if PING:
        try:
            fetch(PING, timeout=10)
        except Exception as error:  # noqa: BLE001
            print(f"failed to ping: {error}", file=sys.stderr)


if __name__ == "__main__":
    main()
